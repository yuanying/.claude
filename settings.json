{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "split-pane",
  "permissions": {
    "allow": [
      "mcp__plugin_context7_context7__get-library-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "Skill(implement)",
      "Update(**/*)",
      "Search(**/*)",
      "Fetch(**/*)",
      "Edit(**/*)",
      "Read(**/*)",
      "Bash(tree:*)",
      "Bash(touch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh api:*)",
      "Bash(git status)",
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(uv sync:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run ty:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python -m pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(mkdir -p:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Update(~/**)",
      "Edit(~/**)",
      "Read(~/**)",
      "Update(/**)",
      "Edit(/**)",
      "Read(/**)",
      "Bash(touch /:*)",
      "Bash(touch ~/:*)",
      "Bash(mkdir -p /**)",
      "Bash(mkdir -p ~/**)",
      "Bash(rm -rf ~/**)",
      "Bash(rm -r ~/**)",
      "Bash(rm -rf /**)",
      "Bash(rm -r /**)"
    ],
    "ask": [
      "Bash(git push -f:*)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -X POST -H 'Content-type: application/json' --data '{\"text\":\"🤖 Claude Code: 入力待ちです。\"}' \"$SLACK_WEBHOOK_URL\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -X POST -H 'Content-type: application/json' --data '{\"text\":\"🤖 Claude Code: タスクが完了しました。\"}' \"$SLACK_WEBHOOK_URL\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "dig@kuu-marketplace": true,
    "code-simplifier@claude-plugins-official": true
  }
}
